// Template for custom CMake user presets.
// Set "COPY_PLUGIN_BASE_PATH" to your mod folder in MO2 or your Fallout 4 VR Data folder.
// Support multiple paths separated by semicolons (i.e. "<path1>;<path2>").
// Set "COPY_PLUGIN_CONFIGURATIONS" to the build configurations to copy on: "all" (default) or a list (i.e. "Release;Tracy" or "Debug;RelWithDebInfo").
// Use "F4VR_COMMON_FRAMEWORK_PATH" to use existing F4VRCommonFramework instead of submodule.
// Rename the file to 'CMakeUserPresets.json' (it is in .gitignore to keep it local to you).
// Build preset names must not repeat the ones in CMakePresets.json ("debug" / "release" / "package" / "tracy").
// Remove this comment block.
// Run:
// cmake --preset custom
// cmake --build --preset custom-debug   (or custom-release, or custom-package to also package the mod into build/package/,
//                                        or custom-tracy for a Release build with the Tracy profiler client)

{
  "version": 3,
  "configurePresets": [
    {
      "name": "custom",
      "cacheVariables": {
        "POST_BUILD_COPY_PLUGIN": true,
        "COPY_PLUGIN_CONFIGURATIONS": "all",
        "COPY_PLUGIN_BASE_PATH": "[MO2 modlist folder]/mods/[my mod] OR [Fallout 4 VR game path]/Data",
        "F4VR_COMMON_FRAMEWORK_PATH": ""
      },
      "inherits": "default"
    }
  ],
  "buildPresets": [
    {
      "name": "custom-debug",
      "configurePreset": "custom",
      "configuration": "Debug"
    },
    {
      "name": "custom-release",
      "configurePreset": "custom",
      "configuration": "Release"
    },
    {
      "name": "custom-package",
      "configurePreset": "custom",
      "configuration": "Release",
      "targets": ["package_mod"]
    },
    {
      "name": "custom-tracy",
      "configurePreset": "custom",
      "configuration": "Tracy"
    }
  ]
}
